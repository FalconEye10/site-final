{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interact-camena", // UPDATE THIS to match the exact name of your Cloudflare Worker/Project
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
